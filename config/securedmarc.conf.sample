[global]
AuthservID      = mail.example.com

# Trust boundary (RFC 8601 section 5).
# SecureDMARC always removes pre-existing Authentication-Results headers that
# claim our AuthservID and assert a dmarc= result.
# It must NOT remove the spf= and dkim= results, because those are the inputs
# it evaluates: SecureSPF and SecureDKIM add them earlier in the same milter
# chain under this same AuthservID, having already removed any forged claims
# for their own methods.
# Only enable this where no other SecureMilter daemon precedes SecureDMARC —
# in that case DMARC has no authentication inputs at all and every message
# will fail alignment.
# StripAuthResults = no

# Organizational domains come from the RFC 9989 DNS tree walk: SecureDMARC
# walks up _dmarc.<name> and each zone declares its own boundary with the psd=
# tag. No external list is required and the daemon is correct without one.
#
# Recommended anyway, for now. The tree walk's last resort is the shortest
# name that published a DMARC record, which assumes a public suffix publishing
# DMARC also publishes psd=y. RFC 9989 is recent and psd= is not yet widely
# deployed, so a registry that publishes a record without the tag would be
# selected as an organizational domain shared by all of its registrants — the
# boundary collapse that lets attacker.co.uk align with victim.co.uk. A Public
# Suffix List rejects that. It can only reject a boundary, never choose one.
#
# Install the list from packages:
#
#     pkg install public_suffix_list
#
# or fetch it yourself from https://publicsuffix.org/list/ (MPL 2.0) and point
# this at wherever you put it.
#
# The file is read once at startup. It changes as registries come and go, so
# refresh it periodically — the package is rebuilt regularly — and restart the
# daemon afterwards. SIGHUP does not reload it.
#
# DEPRECATED. This option exists only to cover the transition to RFC 9989 and
# is expected to be removed in a future version. The RFC replaced the Public
# Suffix List with the DNS tree walk outright, and observes that a PSL "might
# arrive at a different answer" than the walk — so keeping the list is a
# deliberate deviation from the standard, constrained here so it can only
# reject a boundary the walk chose and never choose one itself. As psd= gets
# published more widely the veto stops finding anything to reject. Do not
# build anything on this option that would break when it goes away.
PublicSuffixList = /usr/local/share/public_suffix_list/public_suffix_list.dat

WorkerThreads   = 0
Foreground      = no
PidFile         = /var/run/securedmarc/securedmarc.pid
User            = _dmarc
Syslog          = yes
SyslogFacility  = mail
DnsNameserver   = 127.0.0.1
DnsTimeout      = 5
DnsRetries      = 2
ZmqEndpoint     = tcp://events.internal:5555
ZmqTopic        = dmarc

# --- Resource limits on attacker-controlled message content ---
#
# Both take effect at startup, not on SIGHUP. 0 disables the limit.
#
# DMARC is evaluated from the From header plus the spf= and dkim= results added
# earlier in the milter chain, so this daemon never buffers a message body and
# has no MaxBodyBytes. The header block is what it reads, and an uninspected
# header block is exactly what it must not evaluate against.
#
# A message whose header block exceeds either limit is tempfailed rather than
# delivered: headers past the limit are never seen, so neither a forged
# Authentication-Results nor a second From header hidden beyond it could be
# acted on. Raise these if legitimate mail crossing many forwarders and mailing
# lists is being deferred.
# MaxHeaders     = 500
# MaxHeaderBytes = 1M

[listener:inbound]
Socket          = inet:8894@0.0.0.0
